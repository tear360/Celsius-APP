{
  "name": "celsius-app",
  "productName": "Celsius",
  "version": "1.0.0",
  "description": "Celsius — un store d'applications pour Windows et Android. Installe, met a jour et lance tes apps depuis les GitHub Releases.",
  "author": {
    "name": "TEAR36",
    "email": "tear36.mc@gmail.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/tear360/Celsius-APP",
  "repository": {
    "type": "git",
    "url": "https://github.com/tear360/Celsius-APP.git"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "cross-env CELSIUS_DEV_SERVER=http://localhost:5173 electron .",
    "build": "vite build",
    "preview": "vite preview",
    "cap:sync": "npm run build && cap sync android",
    "android:apk": "npm run cap:sync && cd android && gradlew assembleRelease",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "dist:all": "npm run build && electron-builder --win nsis --linux AppImage --publish never",
    "assets": "capacitor-assets generate --iconBackgroundColor '#0b1020' --splashBackgroundColor '#0b1020'",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.5",
    "vite": "^8.3.1"
  }
}
