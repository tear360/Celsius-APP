# Normalisation des fins de ligne
* text=auto eol=lf

# Scripts Windows : CRLF obligatoire
*.ps1 text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Scripts Unix / Java / Kotlin : LF
gradlew text eol=lf
*.java text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.js  text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.sh  text eol=lf
*.nsh text eol=lf

# Binaires : ne jamais toucher
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.jar binary
*.jks binary
*.keystore binary
*.apk binary
*.exe binary
